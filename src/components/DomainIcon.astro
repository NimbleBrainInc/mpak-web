---
// One outline icon per MTF security domain, keyed by the domain id in
// src/data/security-levels.ts. Unknown ids render nothing.
interface Props {
  domain: string;
  class?: string;
}

const { domain, class: className } = Astro.props;

const PATHS: Record<string, string[]> = {
