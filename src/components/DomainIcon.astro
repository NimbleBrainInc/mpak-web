const paths = PATHS[domain];
---

{
  paths && (
    <svg
      aria-hidden="true"
      class={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    >
      {paths.map((d) => (
        <path stroke-linecap="round" stroke-linejoin="round" d={d} />
      ))}
    </svg>
  )
}
