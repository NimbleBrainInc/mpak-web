---
import { siteConfig } from '../config/site';
import { faqs } from '../data/faqs';
import BaseLayout from '../layouts/BaseLayout.astro';
import { generateCLIToolSchema, generateFAQSchema, generateWebSiteSchema } from '../lib/schema';

const schema = [generateWebSiteSchema(), generateCLIToolSchema(), generateFAQSchema(faqs)];

const COMPARISON_ROWS = [
  {
    label: 'Packaging',
    general: 'Language-specific (npm, pip, Docker)',
    mpak: 'One format (MCPB) for all runtimes',
    cell: 'rounded-l',
  },
  {
    label: 'Install experience',
    general: 'Requires runtime, deps, config',
    mpak: 'Single command, zero deps',
    cell: '',
  },
  {
    label: 'Security scanning',
    general: 'Generic CVE checks',
    mpak: 'MCP-specific: 25 controls, 5 domains',
    cell: '',
  },
  {
    label: 'Trust visibility',
    general: 'None or hidden',
    mpak: 'Public trust score on every package',
    cell: '',
  },
  {
    label: 'Enterprise governance',
    general: 'Limited or paid add-on',
    mpak: 'Self-hostable, federation, audit logs',
    cell: 'rounded-r',
  },
];
---

<BaseLayout
  title="mpak - Secure MCP Server Registry | Open Source"
  description="Open-source package registry for MCP servers. Every bundle scanned with 25 security controls. Trust scores on every package."
  keywords={[
    'ai',
    'package manager',
    'mcp',
    'bundles',
    'ai tools',
    'model context protocol',
    'security',
    'open source',
    'supply chain',
    'mcpb',
    'trust score',
  ]}
  schema={schema}
>
  <div class="min-h-[calc(100vh-80px)]">
    <section aria-label="Hero" class="relative px-4 sm:px-6 lg:px-8 pt-16 sm:pt-24 pb-16">
      <div class="max-w-3xl mx-auto text-center">
        <div class="mb-8">
          <span class="inline-block font-mono text-sm text-mpak-gray-500 tracking-wider mb-4">
            OPEN SOURCE · SECURE · MCP-NATIVE
          </span>
          <h1 class="text-4xl sm:text-5xl font-bold text-mpak-gray-900 tracking-tight">
            The <span class="text-accent-gold-400">secure registry</span> for MCP servers.
          </h1>
          <p class="mt-4 text-lg text-mpak-gray-600">
            Every bundle scanned. Every trust score public. Open source from day one.
          </p>
        </div>

        <form action="/bundles/" method="get" class="mb-6">
          <div class="relative max-w-xl mx-auto">
            <input
              type="text"
              name="search"
              placeholder="Search packages..."
              class="workshop-input w-full px-5 py-4 pl-12 text-lg rounded-xl border-2"
            />
            <svg
              aria-hidden="true"
              class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-mpak-gray-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            <button
              type="submit"
              class="absolute right-2 top-1/2 -translate-y-1/2 px-4 py-2 bg-accent-gold-400 text-mpak-dark font-medium rounded-lg hover:bg-accent-gold-500 transition-colors"
            >
              Search
            </button>
          </div>
        </form>

        <p class="text-mpak-gray-500 text-sm">
          <a href={`${siteConfig.registryUrl}/`} class="text-accent-gold-400 hover:text-accent-gold-300 font-medium"
            >Browse bundles</a
          >
          {' · '}
          <a href="/publish/" class="text-mpak-gray-600 hover:text-mpak-gray-800 font-medium"
            >Publish</a
          >
        </p>
      </div>
    </section>

    <section aria-label="Terminal demo" class="px-4 sm:px-6 lg:px-8 pb-20">
      <div class="max-w-3xl mx-auto">
        <div
          class="bg-mpak-dark rounded-xl overflow-hidden shadow-2xl border border-white/[0.08]"
        >
          <div class="bg-surface-raised px-4 py-3 flex items-center gap-2">
            <div class="flex gap-2">
              <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
            </div>
            <div class="flex-1 text-center text-sm text-mpak-gray-400 font-mono">terminal</div>
          </div>
          <div class="p-5 font-mono text-sm leading-relaxed">
            <div class="flex items-start mb-1">
              <span class="text-accent-cyan mr-3 select-none">$</span>
              <span class="text-mpak-gray-800">mpak search postgres</span>
            </div>
            <div class="ml-6 text-xs mb-4">
              <div
                class="flex gap-x-3 text-mpak-gray-400 mb-1 border-b border-white/[0.08] pb-1"
              >
                <span class="w-48">NAME</span>
                <span class="w-14">VERSION</span>
                <span class="w-10">TRUST</span>
                <span class="hidden sm:inline">DESCRIPTION</span>
              </div>
              <div class="flex gap-x-3 text-mpak-gray-500">
                <span class="text-mpak-gray-700 w-48">@mcp/server-postgres</span>
                <span class="w-14">v0.6.2</span>
                <span class="w-10 text-terminal-success font-semibold">L3</span>
                <span class="text-mpak-gray-400 hidden sm:inline">PostgreSQL database access</span>
              </div>
              <div class="flex gap-x-3 text-mpak-gray-500">
                <span class="text-mpak-gray-700 w-48">@community/pg-admin</span>
                <span class="w-14">v1.2.0</span>
                <span class="w-10 text-accent-gold-400 font-semibold">L2</span>
                <span class="text-mpak-gray-400 hidden sm:inline">PostgreSQL admin tools</span>
              </div>
            </div>

            <div class="flex items-start mb-1">
              <span class="text-accent-cyan mr-3 select-none">$</span>
              <span class="text-mpak-gray-800">mpak install @mcp/server-postgres</span>
            </div>
            <div class="ml-6 text-xs mb-1 space-y-1">
              <div class="text-mpak-gray-500">
                Trust: <span class="text-terminal-success font-semibold">L3 Verified</span>{' '}
                (92/100)
              </div>
              <div class="text-terminal-success">✓ Signed provenance</div>
              <div class="text-terminal-success">✓ No dangerous permissions</div>
              <div class="text-terminal-success">✓ Dependencies vendored</div>
              <div class="text-terminal-success mt-1">
                Installing @mcp/server-postgres@0.6.2... done
              </div>
            </div>

            <div class="flex items-start mt-4">
              <span class="text-accent-cyan mr-3 select-none">$</span>
              <span class="inline-block w-2 h-5 bg-accent-gold-400 animate-cursor-blink"></span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      aria-label="Security features"
      class="px-4 sm:px-6 lg:px-8 py-16 border-y border-white/[0.08]"
    >
      <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl font-bold text-mpak-gray-900 mb-8 text-center">
          Built for MCP security
        </h2>
        <div class="grid gap-6 md:grid-cols-3">
          <div class="workshop-card workshop-card-gold p-6">
            <div
              class="w-10 h-10 bg-accent-gold-glow rounded-lg flex items-center justify-center border border-accent-gold-border mb-4"
            >
              <svg
                aria-hidden="true"
                class="w-5 h-5 text-accent-gold-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
              </svg>
            </div>
            <h3 class="font-semibold text-mpak-gray-900 mb-2">MCPB Format</h3>
            <p class="text-sm text-mpak-gray-600">
              One standardized package format for all MCP servers. Python, Node, or binary, all
              installed the same way.
            </p>
          </div>

          <div class="workshop-card workshop-card-gold p-6">
            <div
              class="w-10 h-10 bg-accent-gold-glow rounded-lg flex items-center justify-center border border-accent-gold-border mb-4"
            >
              <svg
                aria-hidden="true"
                class="w-5 h-5 text-accent-gold-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                ></path>
              </svg>
            </div>
            <h3 class="font-semibold text-mpak-gray-900 mb-2">Built-in Security Scans</h3>
            <p class="text-sm text-mpak-gray-600 mb-3">
              25 controls, 5 domains. Trust score on every publish. L1 through L4 certification.
            </p>
            <a
              href="/security/"
              class="text-sm text-accent-gold-400 hover:text-accent-gold-300 font-medium"
            >
              Learn about certification →
            </a>
          </div>

          <div class="workshop-card workshop-card-gold p-6">
            <div
              class="w-10 h-10 bg-accent-gold-glow rounded-lg flex items-center justify-center border border-accent-gold-border mb-4"
            >
              <svg
                aria-hidden="true"
                class="w-5 h-5 text-accent-gold-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                ></path>
              </svg>
            </div>
            <h3 class="font-semibold text-mpak-gray-900 mb-2">Open Source Registry</h3>
            <p class="text-sm text-mpak-gray-600">
              Entire stack is Apache 2.0. Self-hostable with federation, policies, and audit
              logging.
            </p>
          </div>
        </div>
        <p class="text-sm text-mpak-gray-500 mt-8 text-center">
          Want the full security architecture?{' '}
          <a
            href="/mpak-whitepaper.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent-gold-400 hover:text-accent-gold-300 font-medium"
          >
            Read the whitepaper →
          </a>
        </p>
      </div>
    </section>

    <section aria-label="Comparison with other registries" class="px-4 sm:px-6 lg:px-8 py-16">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl font-bold text-mpak-gray-900 mb-8 text-center">
          Why not npm, PyPI, or Docker Hub?
        </h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-white/[0.08]">
                <th class="text-left py-3 pr-4 font-medium text-mpak-gray-500 w-1/3"></th>
                <th class="text-left py-3 pr-4 font-medium text-mpak-gray-500">
                  General-purpose registries
                </th>
                <th class="text-left py-3 font-medium text-accent-gold-400">mpak</th>
              </tr>
            </thead>
            <tbody class="text-mpak-gray-600">
              {
                COMPARISON_ROWS.map((row, i) => (
                  <tr class={i < COMPARISON_ROWS.length - 1 ? 'border-b border-white/[0.08]' : ''}>
                    <td class="py-3 pr-4 font-medium text-mpak-gray-800">{row.label}</td>
                    <td class="py-3 pr-4">{row.general}</td>
                    <td class:list={['py-3 bg-accent-gold-400/5 px-3', row.cell]}>{row.mpak}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section
      aria-label="Package types"
      class="px-4 sm:px-6 lg:px-8 py-16 border-y border-white/[0.08]"
    >
      <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl font-bold text-mpak-gray-900 mb-8 text-center">Extend your AI</h2>
        <div class="max-w-xl mx-auto">
          <div class="workshop-card workshop-card-gold p-6">
            <div class="flex items-center gap-3 mb-4">
              <div
                class="w-10 h-10 bg-accent-gold-glow rounded-lg flex items-center justify-center border border-accent-gold-border"
              >
                <svg
                  aria-hidden="true"
                  class="w-5 h-5 text-accent-gold-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-mpak-gray-900">Bundles</h3>
                <p class="text-xs text-mpak-gray-500 uppercase tracking-wide">Capabilities</p>
              </div>
            </div>
            <p class="text-sm text-mpak-gray-600 mb-4">
              Pre-built servers that give your AI new abilities. Connect to databases, call APIs,
              access file systems. Every bundle scanned with 25 security controls.
            </p>
            <ul class="text-sm text-mpak-gray-500 space-y-1 mb-5">
              <li class="flex items-center gap-2">
                <span class="w-1 h-1 bg-accent-gold-400 rounded-full"></span>
                Database access
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1 h-1 bg-accent-gold-400 rounded-full"></span>
                API integrations
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1 h-1 bg-accent-gold-400 rounded-full"></span>
                File operations
              </li>
            </ul>
            <div class="flex items-center justify-between">
              <code class="text-xs bg-surface px-2 py-1 rounded text-mpak-gray-600 font-mono">
                mpak bundle pull [package]
              </code>
              <a
                href={`${siteConfig.registryUrl}/`}
                class="text-sm text-accent-gold-400 hover:text-accent-gold-300 font-medium"
              >
                Browse bundles →
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      aria-label="Publish to mpak"
      class="px-4 sm:px-6 lg:px-8 py-12 bg-surface-raised border-y border-white/[0.08]"
    >
      <div
        class="max-w-2xl mx-auto flex flex-col sm:flex-row items-center gap-6 text-center sm:text-left"
      >
        <div class="flex-1">
          <h3 class="text-lg font-semibold text-mpak-gray-900 mb-1">Built something for AI?</h3>
          <p class="text-mpak-gray-500 text-sm">
            Publish bundles to mpak. Security scanning, verified provenance, one-command installs.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 flex-shrink-0">
          <a
            href="/publish/bundles/"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-accent-gold-400 text-mpak-dark font-medium rounded-lg hover:bg-accent-gold-500 hover:shadow-[0_0_20px_rgba(245,158,11,0.3)] transition-all"
          >
            Publish a bundle →
          </a>
        </div>
      </div>
    </section>

    <section id="install" aria-label="Install the CLI" class="px-4 sm:px-6 lg:px-8 py-16">
      <div class="max-w-xl mx-auto text-center">
        <h2 class="text-2xl font-bold text-mpak-gray-900 mb-6">Install the CLI</h2>
        <div
          class="bg-surface text-mpak-gray-800 p-4 rounded-xl font-mono text-sm relative group border border-white/[0.08]"
        >
          <code>npm install -g @nimblebrain/mpak</code>
          <button
            type="button"
            id="copy-install"
            data-copy="npm install -g @nimblebrain/mpak"
            class="absolute right-3 top-1/2 -translate-y-1/2 text-mpak-gray-500 hover:text-white transition-colors opacity-0 group-hover:opacity-100"
            title="Copy to clipboard"
          >
            <svg
              aria-hidden="true"
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
              ></path>
            </svg>
          </button>
        </div>
        <p class="text-mpak-gray-500 text-sm mt-4">
          Then run{' '}
          <code class="bg-surface px-2 py-1 rounded text-mpak-gray-600 font-mono">mpak search</code
          >{' '} to get started
        </p>
      </div>
    </section>

    <section aria-label="Frequently asked questions" class="px-4 sm:px-6 lg:px-8 py-16">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-bold text-mpak-gray-900 mb-8 text-center">
          Frequently Asked Questions
        </h2>
        <div class="space-y-4">
          {
            faqs.map((faq) => (
              <details class="group workshop-card overflow-hidden">
                <summary class="flex items-center justify-between p-5 cursor-pointer hover:bg-surface-overlay transition-colors">
                  <h3 class="font-semibold text-mpak-gray-900 pr-4">{faq.question}</h3>
                  <svg
                    aria-hidden="true"
                    class="w-5 h-5 text-mpak-gray-400 flex-shrink-0 transition-transform group-open:rotate-180"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                </summary>
                <div class="px-5 pb-5 text-mpak-gray-600">{faq.answer}</div>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </div>

  <script>
    const btn = document.getElementById('copy-install');
    btn?.addEventListener('click', () => {
      const text = btn.dataset.copy;
      if (text) navigator.clipboard.writeText(text);
    });
  </script>
</BaseLayout>
